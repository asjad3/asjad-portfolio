# Visitor highlights. Locally they're saved to .data/highlights.json; on Vercel, connect an
# Upstash Redis (KV) store from the Vercel Marketplace and these two are set for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret used to delete highlights: curl -X DELETE "$SITE/api/highlights?id=ID" -H "Authorization: Bearer $HIGHLIGHTS_ADMIN_TOKEN"
HIGHLIGHTS_ADMIN_TOKEN=

# Optional salt for the hashed rate-limit key
HIGHLIGHTS_SALT=
